# ─── Database (PostgreSQL) ────────────────────────────────────────────────
# Works locally and on Vercel. Use any Postgres instance — a free hosted DB
# (Neon, Supabase, Vercel Postgres) is easiest. Example:
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/jay_portfolio?schema=public"

# ─── Auth ─────────────────────────────────────────────────────────────────
# 32+ char random secret used to sign session tokens.
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Credentials for the initial admin, created by the seed script.
ADMIN_EMAIL="jay@example.com"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Jay"

# ─── Storage ──────────────────────────────────────────────────────────────
# Which storage provider to use for uploaded assets (GLB / images / PDFs).
#   local  -> writes to ./storage, served via /api/assets/[...path]
#   s3     -> any S3-compatible object storage (AWS S3, Cloudflare R2, etc.)
STORAGE_PROVIDER="local"

# Local provider settings
STORAGE_LOCAL_DIR="./storage"

# S3-compatible provider settings (only needed when STORAGE_PROVIDER=s3)
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL assets are served from (CDN or bucket public URL)
S3_PUBLIC_URL=""

# Public base URL of the site (used for absolute preview links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
